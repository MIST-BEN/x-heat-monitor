{
  "manifest_version": 3,
  "name": "X Heat Pulse - 帖子热度差分监测器",
  "version": "1.2.0",
  "description": "面向创作者的 X (Twitter) 帖子热度差分与自始增量检测插件。直接在推文旁标出 5 分钟增量与自看到起的总增量。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X Heat Pulse"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content_script.js"],
      "css": ["content_style.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ]
}
